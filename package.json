{
  "name": "bitrise-run-build",
  "version": "1.2.0",
  "description": "Run Bitrise build as a step in GitHub Actions workflow.",
  "private": true,
  "homepage": "https://github.com/p-mazhnik/bitrise-run-build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-mazhnik/bitrise-run-build.git"
  },
  "bugs": {
    "url": "https://github.com/p-mazhnik/bitrise-run-build/issues"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "build": "ncc build src/index.ts -o dist",
    "package": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package:watch": "npm run build -- --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "all": "npm run format:write && npm run lint && npm run test && npm run package",
    "typecheck": "tsc --noEmit --project .github/linters/tsconfig.json --rootDir ."
  },
  "license": "MIT",
  "jest": {
    "verbose": true,
    "clearMocks": true,
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "isolatedModules": true
          }
        }
      ]
    },
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ]
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1",
    "axios": "^1.21.0",
    "axios-retry": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "glob@>=9 <14.0.2": "^14.0.3"
  }
}
