{
  "name": "bitrise-run-build",
  "version": "1.2.0",
  "description": "Run Bitrise build as a step in GitHub Actions workflow.",
  "private": true,
  "homepage": "https://github.com/p-mazhnik/bitrise-run-build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-mazhnik/bitrise-run-build.git"
  },
  "bugs": {
    "url": "https://github.com/p-mazhnik/bitrise-run-build/issues"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "vitest run --coverage",
    "format:write": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "build": "ncc build src/index.ts -o dist",
    "package": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package:watch": "npm run build -- --watch",
    "test": "vitest run",
    "all": "npm run check && npm run typecheck && npm run ci-test && npm run package",
    "typecheck": "tsc --project tsconfig.check.json",
    "check": "biome ci .",
    "check:write": "biome check --write .",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1",
    "axios": "^1.21.0",
    "axios-retry": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  }
}
