{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/dist",
      "!!**/coverage",
      "!!**/lib",
      "!**/__tests__/runner",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "quoteProperties": "asNeeded",
      "trailingCommas": "none",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "bracketSameLine": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "yaml": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": true,
      "proseWrap": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noStaticOnlyClass": "error",
        "noUselessConstructor": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useAwaitThenable": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noInferrableTypes": "error",
        "noNonNullAssertion": "warn",
        "useConsistentArrayType": "error",
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": {
            "accessibility": "noPublic"
          }
        },
        "useForOf": "warn",
        "useShorthandFunctionType": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noForIn": "error",
        "useArraySortCompare": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/bitrise/options.ts", "src/bitrise/types.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
